  SELECT 
    pl.id,
    ps.subject AS subjectName,
    b.brand as brandName,
    pl.name,
    pl.desc,
    pl.price,
    pl.image,
    pl.size,
    pl.order,
    pl.regist,
    pl.sell
  FROM 
    PRODUCT_LIST pl
  INNER JOIN
    PRODUCT_SUBJECT ps
      ON ps.id = pl.subject
  INNER JOIN
    BRANDS b
      ON b.id = pl.brand
  WHERE
    1 = 1
    AND b.brand = 'bsrabbit'
  ORDER BY
    pl.regist DESC
