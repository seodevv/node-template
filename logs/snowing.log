2023-10-26T10:02:00.912Z [[32minfo[39m] 
  SELECT 
    pl.id,
    ps.subject AS subjectName,
    b.brand as brandName,
    pl.name,
    pl.desc,
    pl.price,
    pl.image,
    pl.size,
    pl.order,
    pl.regist,
    pl.sell
  FROM 
    PRODUCT_LIST pl
  INNER JOIN
    PRODUCT_SUBJECT ps
      ON ps.id = pl.subject
  INNER JOIN
    BRANDS b
      ON b.id = pl.brand
  INNER JOIN
    (SELECT
        id
      FROM
        PRODUCT_SIZE
      WHERE
        size IN ("FREE")
      GROUP BY
        id) s
      ON s.id = pl.id
  WHERE
    1 = 1
    ORDER BY
    pl.regist DESC
  LIMIT ?
